# Copy to .env beside docker-compose.prod.yml and fill in the blanks. Never commit it.
APP_NAME="Vet Clinic"
APP_ENV=production
APP_DEBUG=false
# base64:<32 random bytes>, e.g. base64:$(openssl rand -base64 32)
APP_KEY=
APP_URL=http://CHANGE_ME
APP_TIMEZONE=UTC
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vet_clinic
DB_USERNAME=vet
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local
FILES_DISK=local
MAIL_MAILER=log
MONEY_DISPLAY_MODE=toman

# fake writes OTPs to storage/logs/laravel.log instead of sending SMS.
SMS_DRIVER=fake
KAVENEGAR_API_KEY=
SMS_ALLOWLIST=

# fake returns canned results; set neshan plus a key for the live map.
MAP_DRIVER=fake
NESHAN_API_KEY=

# Creates the first admin on db:seed when both are set.
SEED_ADMIN_MOBILE=
SEED_ADMIN_PASSWORD=
